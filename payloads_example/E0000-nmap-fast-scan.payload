#!/bin/bash
set -eEuo pipefail

# Constants
readonly NAME="nmap-fast-scan"
readonly SHMLED_PROCNAME="shmled_runtime"
readonly DHCP_TRY=30
readonly NTPD_TRY=30
readonly TEST_PING_INTERNET_ADDR="1.1.1.1"
readonly NMAP_XSL_FILE="/usr/share/nmap/nmap.xsl"
readonly PAYLOAD_LOOT_PREFIX="${NAME}-$(head -c 12 /dev/urandom | xxd -p)"
readonly LOOT_BASE_DIR="/mnt/udisk/loot"
readonly LOOT_DIR="${LOOT_BASE_DIR}/${PAYLOAD_LOOT_PREFIX}"
readonly NMAP_OPTIONS="-F -Pn -v"

# Globals
IPV4_ADDR=""
IPV4_CIDR=""
IPV4_MASK=""
IPV4_NETADDR=""
IPV4_BRDADDR=""
IPV6_LINKLOCAL=""
IPV6_CIDR=""
HAVE_INTERNET="no"
NTPD_UPDATE_OK="no"

# Error handler
err_exit() {
    local exit_code=$?
    local src_file=${BASH_SOURCE[1]}
    local src_line=${BASH_LINENO[0]}

    set +eE
    killall -9 "$SHMLED_PROCNAME" 2>/dev/null || true
    nohup shmled -c#FF0000 -lbs500000 >/dev/null 2>&1 &
    echo "[ERR_EXIT] Trap caught! Exit code $exit_code in $src_file:$src_line" | tee -a "$LOOT_DIR/log"
    echo "============================== PAYLOAD ERROR ==============================" | tee -a "$LOOT_DIR/log"
    exit 1
}


# Convert CIDR to netmask
cidr_to_netmask() {
    local bits=$1 mask="" i=0
    while [ $i -lt 4 ]; do
        if [ $bits -ge 8 ]; then
            mask="$mask.255"
            bits=$((bits - 8))
        elif [ $bits -gt 0 ]; then
            mask="$mask.$(( 256 - 2**(8 - bits) ))"
            bits=0
        else 
            mask="$mask.0"
        fi
        i=$((i + 1))
    done
    echo "${mask#.}"
}

ip_to_int() {
    local IFS=.
    read -r a b c d <<< "$1"
    echo $(( (a << 24) + (b << 16) + (c << 8) + d ))
}

int_to_ip() {
    local ip=$1
    echo "$(( (ip >> 24) & 255 )).$(( (ip >> 16) & 255 )).$(( (ip >> 8) & 255 )).$(( ip & 255 ))"
}

get_ip_info() {
    local iface="${1:-eth0}"

    local ip_cidr
    ip_cidr=$(ip -4 addr show dev "$iface" | awk '/inet / {print $2}')
    if [[ -n "$ip_cidr" ]]; then
        IPV4_ADDR=${ip_cidr%/*}
        IPV4_CIDR=${ip_cidr#*/}
        IPV4_MASK=$(cidr_to_netmask "$IPV4_CIDR")
        local ip_int mask_int net_int brd_int
        ip_int=$(ip_to_int "$IPV4_ADDR")
        mask_int=$(ip_to_int "$IPV4_MASK")
        net_int=$((ip_int & mask_int))
        brd_int=$((net_int | (~mask_int & 0xFFFFFFFF)))
        IPV4_NETADDR=$(int_to_ip "$net_int")
        IPV4_BRDADDR=$(int_to_ip "$brd_int")
    fi

    local ipv6_info
    ipv6_info=$(ip -6 addr show dev "$iface" | awk '/inet6 fe80/ {print $2}' | head -n1)
    if [[ -n "$ipv6_info" ]]; then
        IPV6_LINKLOCAL=${ipv6_info%/*}
        IPV6_CIDR=${ipv6_info#*/}
    fi
}

wait_eth0() {
    (exec -a "$SHMLED_PROCNAME" shmled -c#FFFF00 -lds300000) &
    ip link set eth0 up

    # Start LED blink to indicate waiting
    

    echo "[wait_eth0] Waiting for RJ45 cable plug (eth0 up)..."
    while true; do
        ETH_STATUS="$(cat /sys/class/net/eth0/operstate)"
        if [ "$ETH_STATUS" = "up" ]; then
            break
        fi
        sleep 1
    done
    
    echo "[wait_eth0] Link is up. Waiting for dhcp address..."
    # Start DHCP
    udhcpc -R -b -p /var/run/udhcpc.eth0.pid -i eth0

    # Wait for IP address
    for i in $(seq 1 "$DHCP_TRY"); do
        get_ip_info eth0
        if [ -n "$IPV4_ADDR" ]; then
            break
        fi
        sleep 1
    done

    # Stop LED blink
    killall "$SHMLED_PROCNAME" 2>/dev/null || true

    # Check if IP was acquired
    if [ -z "$IPV4_ADDR" ]; then
        echo "[wait_eth0] Error get the ip address via dhcp... abort!" >&2
        return 1
    fi
    echo "[wait_eth0] Get ip address successful."
}

init() {
    if ping -qw2 "$TEST_PING_INTERNET_ADDR"; then
        HAVE_INTERNET="yes"
        echo "Ping $TEST_PING_INTERNET_ADDR successful, Now trying to update datetime via NTP server..."

        # Launch ntpd in background
        ntpd -4gqn -I eth0 &
        NTPD_PID=$!

        # Wait up to 5 seconds for it to exit
        for i in $(seq 1 "$NTPD_TRY"); do
            if ! kill -0 "$NTPD_PID" 2>/dev/null; then
                wait "$NTPD_PID" && NTPD_UPDATE_OK="yes"
                echo "Datetime update successful. Time: `date -u`"
                return
            fi
            sleep 1
        done

        # Timeout reached — kill it
        kill "$NTPD_PID" 2>/dev/null || true
        echo "NTPD update timeout! The timestamp may incorrect."
    else
        echo "Ping $TEST_PING_INTERNET_ADDR failed. The payload will running without Internet connection."
    fi
}


main() {
    (exec -a "$SHMLED_PROCNAME" shmled -c#FF0000 -lbs50000) &
    get_ip_info eth0
    echo "Starting nmap with optinos: $NMAP_OPTIONS ..."
    nmap $NMAP_OPTIONS "${IPV4_ADDR}/${IPV4_CIDR}" -oA "$LOOT_DIR/nmap" --stylesheet "$NMAP_XSL_FILE"
}

# Main flow
trap err_exit SIGINT SIGTERM ERR
mkdir -p "$LOOT_DIR"

{
    echo "PAYLOAD_NAME=$NAME"
    echo "============================== PAYLOAD START =============================="
} | tee -a "$LOOT_DIR/log"


{
    wait_eth0
    init
    main
} > >(ts "%b %d %Y %T:" | tee -a "$LOOT_DIR/log") 2>&1

{
    echo "============================= PAYLOAD SUCCESS ============================="
    echo "IPV4_ADDR=$IPV4_ADDR/$IPV4_CIDR"
    echo "IPV4_MASK=$IPV4_MASK"
    echo "IPV4_NETADDR=$IPV4_NETADDR"
    echo "IPV4_BRDADDR=$IPV4_BRDADDR"
    echo "IPV6_ADDR=$IPV6_LINKLOCAL/$IPV6_CIDR"
    echo "HAVE_INTERNET=$HAVE_INTERNET"
    echo "NTPD_UPDATE_OK=$NTPD_UPDATE_OK"

    killall "$SHMLED_PROCNAME" 2>/dev/null || true

    nohup shmled -c#00FF00 -lds1000000 >/dev/null 2>&1 &

} | tee -a "$LOOT_DIR/log"


if [ "$NTPD_UPDATE_OK" == "yes" ]; then
    mv "$LOOT_DIR" "${LOOT_BASE_DIR}/${NAME}-$(date +%m-%d-%Y-%H%M%S)"
else
    mv "$LOOT_DIR" "${LOOT_BASE_DIR}/${NAME}-${PAYLOAD_LOOT_PREFIX}-NONTPSYNC"
fi

sync
exit 0

